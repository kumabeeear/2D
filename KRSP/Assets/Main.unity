--- !u!114 &1445306300
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1445306259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 40
  indentLevel: 0
  storyText: "I know of such a person. If you travel south from our country to a
    coastal nation, there is an amazing knight in the knights\u2019 guild there. "
  description: 
  character: {fileID: 1578190102}
  portrait: {fileID: 21300000, guid: 85273443eb9674f88902a11bf76a3339, type: 3}
