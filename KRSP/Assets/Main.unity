  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 41
  indentLevel: 0
  storyText: Before Sir Lancelot traveled to our country, during an international
    event, that knight not only won the strength contest but also broke a thousand-year
    palace record.
  description: 
  character: {fileID: 1578190102}
  portrait: {fileID: 21300000, guid: 85273443eb9674f88902a11bf76a3339, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
